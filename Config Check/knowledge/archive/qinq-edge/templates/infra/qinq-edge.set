# Infrastructure template for the qinq-edge role.
# Syntax: see knowledge/README.md

# @id INFRA-QINQ-PHY @sev 4 @title "QinQ hand-off interface missing standard physical settings" @doc "HLD-qinq-edge §3.1"
# @scope ^set interfaces (?P<ifd>(?:ge|xe|et)-\S+) unit \d+ vlan-tags outer
set interfaces {{ifd}} flexible-vlan-tagging
set interfaces {{ifd}} encapsulation flexible-ethernet-services
set interfaces {{ifd}} mtu 9192
set interfaces {{ifd}} description {{*}}

# @id INFRA-QINQ-UNIT @sev 3 @title "QinQ service unit missing bridge encapsulation or description" @doc "HLD-qinq-edge §3.2"
# @scope ^set interfaces (?P<ifd>\S+) unit (?P<unit>\d+) vlan-tags outer
set interfaces {{ifd}} unit {{unit}} encapsulation vlan-bridge
set interfaces {{ifd}} unit {{unit}} description {{*}}

# @id INFRA-VLAN-NAME @sev 3 @title "VLAN name does not match its QinQ tags" @doc "HLD-qinq-edge §3.3"
# @builtin vlan_name_tags

# @id INFRA-IRB @sev 2 @title "IRB missing description or customer MTU" @doc "HLD-qinq-edge §3.4"
# @scope ^set interfaces irb unit (?P<irb>\d+) family inet address
set interfaces irb unit {{irb}} description {{*}}
set interfaces irb unit {{irb}} family inet mtu 1500

# @id INFRA-LLDP @sev 2 @title "LLDP not enabled on all interfaces" @doc "HLD-qinq-edge §3.5"
set protocols lldp interface all

# @id INFRA-MGMT-RA @sev 2 @title "IPv6 router advertisements enabled on management interface" @doc "HLD-qinq-edge §2.1"
!set protocols router-advertisement interface fxp0.0{{*}}

# @id INFRA-MCLAG-ORPHAN @sev 2 @title "Leftover MC-LAG configuration in a role that does not use MC-LAG" @doc "HLD-qinq-edge §3.7"
# @builtin orphan_mclag
