set version 25.4R1.12
set system host-name QFX1
set system root-authentication encrypted-password /* SECRET-DATA */
set system login class cc-ro permissions view
set system login class cc-ro permissions view-configuration
set system login class cc-ro deny-commands "(request|clear|restart|start|file|configure)"
set system login user configcheck uid 2000
set system login user configcheck class cc-ro
set system login user configcheck authentication ssh-ed25519 /* SECRET-DATA */
set system services netconf ssh
set system services ssh root-login allow
set system services ssh protocol-version v2
set system arp aging-timer 5
set interfaces ge-0/0/3 description "Cisco ASR - QinQ outer 107 inner 101"
set interfaces ge-0/0/3 flexible-vlan-tagging
set interfaces ge-0/0/3 mtu 9192
set interfaces ge-0/0/3 encapsulation flexible-ethernet-services
set interfaces ge-0/0/3 unit 101 description "QinQ service outer 107 inner 101"
set interfaces ge-0/0/3 unit 101 encapsulation vlan-bridge
set interfaces ge-0/0/3 unit 101 vlan-tags outer 107
set interfaces ge-0/0/3 unit 101 vlan-tags inner 101
set interfaces ge-0/0/3 unit 111 description "QinQ service outer 107 inner 111"
set interfaces ge-0/0/3 unit 111 encapsulation vlan-bridge
set interfaces ge-0/0/3 unit 111 vlan-tags outer 107
set interfaces ge-0/0/3 unit 111 vlan-tags inner 111
set interfaces fxp0 unit 0 family inet address 192.168.1.52/24
set interfaces irb unit 101 description "Layer 3 termination for QinQ service 107/101"
set interfaces irb unit 101 family inet mtu 1500
set interfaces irb unit 101 family inet address 10.10.10.2/30
set interfaces irb unit 111 description "Layer 3 termination for QinQ service 107/111"
set interfaces irb unit 111 family inet mtu 1500
set interfaces irb unit 111 family inet address 10.10.11.2/30
set multi-chassis mc-lag consistency-check
set routing-instances SIPT-QINQ instance-type virtual-router
set routing-instances SIPT-QINQ protocols bgp group CISCO-ASR type external
set routing-instances SIPT-QINQ protocols bgp group CISCO-ASR peer-as 2222
set routing-instances SIPT-QINQ protocols bgp group CISCO-ASR neighbor 10.10.10.1 description "Cisco ASR QinQ BGP peer"
set routing-instances SIPT-QINQ protocols bgp local-as 1111
set routing-instances SIPT-QINQ interface irb.101
set routing-instances SIPT-QINQ-2 instance-type virtual-router
set routing-instances SIPT-QINQ-2 protocols bgp group CISCO-ASR type external
set routing-instances SIPT-QINQ-2 protocols bgp group CISCO-ASR peer-as 2222
set routing-instances SIPT-QINQ-2 protocols bgp group CISCO-ASR neighbor 10.10.11.1 description "Cisco ASR QinQ BGP peer"
set routing-instances SIPT-QINQ-2 protocols bgp local-as 1111
set routing-instances SIPT-QINQ-2 interface irb.111
set protocols router-advertisement interface fxp0.0 managed-configuration
set protocols lldp interface all
set protocols lldp-med interface all
set vlans QINQ-107-101 vlan-id 101
set vlans QINQ-107-101 interface ge-0/0/3.101
set vlans QINQ-107-101 l3-interface irb.101
set vlans QINQ-117-111 vlan-id 111
set vlans QINQ-117-111 interface ge-0/0/3.111
set vlans QINQ-117-111 l3-interface irb.111
