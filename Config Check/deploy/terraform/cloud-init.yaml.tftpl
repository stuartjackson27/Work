#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
timezone: Etc/UTC

users:
  - name: ${admin_user}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
%{ for k in ssh_keys ~}
      - ${k}
%{ endfor ~}

ssh_pwauth: false
package_update: true
packages: [git, curl, ca-certificates, qemu-guest-agent]

write_files:
%{ if deploy_key != "" ~}
  - path: /root/.ssh/gh_deploy
    permissions: "0600"
    owner: root:root
    content: |
      ${indent(6, trimspace(deploy_key))}
%{ endif ~}
  - path: /usr/local/sbin/config-check-firstboot
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      exec >>/var/log/config-check-deploy.log 2>&1
      echo "=== first boot $(date -Is) ==="
%{ if deploy_key != "" ~}
      export GIT_SSH_COMMAND="ssh -i /root/.ssh/gh_deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
%{ endif ~}
      [ -d /opt/config-check/.git ] || git clone --branch "${repo_ref}" "${repo_url}" /opt/config-check
      APP_USER="${admin_user}" REPO_REF="${repo_ref}" \
%{ if deploy_key != "" ~}
      DEPLOY_KEY=/root/.ssh/gh_deploy \
%{ endif ~}
      OLLAMA_URL="${ollama_url}" OLLAMA_MODEL="${ollama_model}" BACKUP_DIR="${backup_dir}" \
        bash /opt/config-check/scripts/deploy.sh
      echo "=== done $(date -Is) ==="

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
  - [/usr/local/sbin/config-check-firstboot]
