# Copy to terraform.tfvars (git-ignored) and fill in.
proxmox_endpoint  = "https://192.168.1.14:8006/"
proxmox_api_token = "terraform@pve!tf=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
node_name         = "pve"

vm_id        = 111
vm_datastore = "local-zfs"   # check: pvesm status
ip_cidr      = "192.168.1.39/24"
gateway      = "192.168.1.1"

admin_user     = "stuart"
admin_ssh_keys = ["ssh-ed25519 AAAA... stuart@desktop"]

# Private repo: create a read-only deploy key on GitHub and paste the PRIVATE half here
github_deploy_key = <<-KEY
-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----
KEY

ollama_url   = "http://192.168.1.232:11434"
ollama_model = "deepseek-r1:14b"
backup_dir   = "/var/backups/config-check"   # better: an NFS/SMB mount off the Proxmox host
